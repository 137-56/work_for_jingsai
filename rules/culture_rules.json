  {
    "id": "R006",
    "name": "寓意须给出且为完整词条",
    "category": "寓意与要素完整性",
    "version": "1.0",
    "severity": "medium",
    "source": "单字寓意（如「福」）无法构成可推导的表述，须用完整词条（如「五福临门」），否则「寓意可由母题推导」这一立论不成立",
    "trigger": {
      "op": "any",
      "conditions": [
        { "field": "structure.center_motif.name", "op": "contains", "value": "纹" }
      ]
    },
    "constraint": { "type": "required_evidence", "field": "intent.blessing" },
    "action": {
      "message": "寓意字段缺少有效依据：「{term}」——请使用完整词条（如「五福临门」「连年有余」），单字不构成可推导的寓意",
      "suggestions": { "intent.blessing": "五福临门 / 连年有余 / 吉祥如意" }
    }
  },
