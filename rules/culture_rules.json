[
  {
    "id": "R001",
    "name": "婚庆场景禁用哀悼意象",
    "category": "场合-意象冲突",
    "version": "1.0",
    "severity": "high",
    "source": "《中国传统吉祥图案》相关章节 + 民俗通行认知：白菊、挽联、纸钱属祭奠意象，与婚庆相斥",
    "trigger": {
      "op": "any",
      "conditions": [
        { "field": "intent.occasion", "op": "intersect", "value": ["婚庆"] }
      ]
    },
    "constraint": {
      "type": "forbidden_terms",
      "scope": ["structure.center_motif.name", "structure.center_motif.elements", "intent.blessing"],
      "terms": ["菊花", "白菊", "挽联", "纸钱", "素白"]
    },
    "action": {
      "message": "婚庆场合不宜出现「{term}」——该意象属祭奠范畴，建议替换为「{suggestion}」",
      "suggestions": {
        "菊花": "牡丹 / 莲花 / 宝相花",
        "白菊": "牡丹 / 莲花",
        "挽联": "双喜 / 龙凤",
        "纸钱": "铜钱 / 元宝",
        "素白": "正红 / 金色"
      }
    }
  },
